generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// ENUMS
// =======================

enum UserRole {
  USER
  ADMIN
}

enum AccountType {
  USER_WALLET
  SYSTEM
}

enum SystemAccountType {
  TREASURY
  UPI_CLEARING
  BANK_CLEARING
  ATM_CLEARING
  ADMIN_INITIATED
  FOREIGN_SETTLEMENT
  REFUND_ACCOUNT
  FEE_REVENUE
  SUSPENSE
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSE
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum LockingStrategy {
  OPTIMISTIC
  PESSIMISTIC
}

enum EntryType {
  DEBIT
  CREDIT
}

enum TransactionEventType {
  PAYMENT_INITIATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REVERSED
  LOCK_ACQUIRED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
}

enum OutboxEventType {
  TRANSACTION_COMPLETED
  TRANSACTION_FAILED
}

// =======================
// USER
// =======================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)

  createdAt DateTime @default(now())

  accounts     Account[]
  transactions Transaction[]

  @@map("users")
}

// =======================
// ACCOUNT
// =======================

model Account {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  type AccountType
  aadhaarNumber String? @unique

  systemType SystemAccountType?

  currency String @default("INR")

  version Int @default(0)

  status AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  ledgerEntries LedgerEntry[]

  balance AccountBalance?

  @@map("accounts")
}

// =======================
// TRANSACTION
// =======================
model Transaction {
  id String @id @default(uuid()) @db.Uuid

  type TransactionType
  status TransactionStatus

  initiatorUserId String @db.Uuid
  initiator User @relation(fields: [initiatorUserId], references: [id])

  amount BigInt

  currency String @default("INR")

  idempotencyKey String @unique
  lockingStrategy LockingStrategy
  reversalOfId String? @db.Uuid

  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]
  events TransactionEvent[]

  @@map("transactions")
}

// =======================
// LEDGER ENTRY
// =======================

model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  direction EntryType

amount BigInt

balanceAfter BigInt

  createdAt DateTime @default(now())

  @@map("ledger_entries")
}

// =======================
// TRANSACTION EVENTS
// =======================

model TransactionEvent {
  id String @id @default(uuid()) @db.Uuid

  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  event TransactionEventType

  metadata Json?

  createdAt DateTime @default(now())

  @@map("transaction_events")
}

// =======================
// IDEMPOTENCY KEYS
// =======================

model IdempotencyKey {
  key String @id

  requestHash String

  responseBody Json?

  status IdempotencyStatus

  createdAt DateTime @default(now())

  expiresAt DateTime

  @@map("idempotency_keys")
}

// =======================
// RECONCILIATION RUNS
// =======================

model ReconciliationRun {
  id String @id @default(uuid()) @db.Uuid

  startedAt DateTime

  completedAt DateTime?

  accountsChecked Int

  driftFound Boolean

  driftDetails Json?

  dryRun Boolean

  @@map("reconciliation_runs")
}

// =======================
// OUTBOX EVENTS
// =======================

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid

  eventType OutboxEventType

  payload Json

  status OutboxStatus

  createdAt DateTime @default(now())

  publishedAt DateTime?

  @@map("outbox_events")
}

// =======================
// ACCOUNT BALANCE
// =======================

model AccountBalance {
  accountId String @id @db.Uuid

  account Account @relation(fields: [accountId], references: [id])

  cachedBalance BigInt @default(0)
  lastLedgerEntryId String? @db.Uuid

  updatedAt DateTime @updatedAt

  @@map("account_balances")
}
